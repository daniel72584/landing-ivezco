{
  "file-edit-permissions": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/protect-env.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
